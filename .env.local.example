# ──────────────────────────────────────────────
# App Security
# ──────────────────────────────────────────────
# The passcode required to access the app
NEXT_PUBLIC_LOCAL_PASSCODE=1234

# Random API key for the iOS Shortcuts webhook (generate with: openssl rand -hex 32)
API_SECRET_KEY=
# Expose same key to the client so the queue drain can authenticate
NEXT_PUBLIC_API_SECRET_KEY=

# ──────────────────────────────────────────────
# Mom's Account Detection
# ──────────────────────────────────────────────
# Comma-separated substrings to match against rawSender (case-insensitive)
MOM_ACCOUNT_IDENTIFIERS=MOM,mom-upi@bank

# ──────────────────────────────────────────────
# GitHub Gist Sync (multi-device, 100% free)
# ──────────────────────────────────────────────
NEXT_PUBLIC_GIST_TOKEN=
NEXT_PUBLIC_GIST_ID=
